#!/usr/bin/env python3
import argparse
import glob
import math
import re
import hashlib
import json
import os
import sys
import numpy as np
from src import config, storage, parser, intents, ai
from src.schema import CodeEntity, EntitySummary, Intent

def cmd_scan(args):
    print(f"🚀 Scanning {args.root}...")

    p = parser.CodeParser()
    storage.ensure_index_dir()

    scan_root = os.path.normpath(args.root)
    scan_root_abs = os.path.abspath(scan_root)
    scan_state_file = os.path.join(
        storage.INDEX_DIR,
        "scan_state.json",
    )

    # Existing entities are kept so a resumed scan can continue where the
    # previous run stopped. Changed files replace only their own entities.
    entities_map = storage.load_entities()

    try:
        with open(scan_state_file, "r", encoding="utf-8") as f:
            scan_state = json.load(f)

        if not isinstance(scan_state, dict):
            scan_state = {}
    except FileNotFoundError:
        scan_state = {}
    except Exception as ex:
        print(
            "⚠️  Could not read previous scan state: "
            f"{ex}. Starting a fresh state."
        )
        scan_state = {}

    def file_digest(path):
        digest = hashlib.sha256()

        with open(path, "rb") as f:
            while True:
                chunk = f.read(1024 * 1024)
                if not chunk:
                    break
                digest.update(chunk)

        return digest.hexdigest()

    def save_scan_state():
        tmp_file = scan_state_file + ".tmp"

        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(
                scan_state,
                f,
                indent=2,
                ensure_ascii=False,
                sort_keys=True,
            )

        os.replace(tmp_file, scan_state_file)

    def checkpoint():
        storage.save_entities(list(entities_map.values()))
        save_scan_state()

    def remove_entities_for_path(path):
        stale_ids = [
            entity_id
            for entity_id, entity in entities_map.items()
            if os.path.normpath(entity.path) == path
        ]

        for entity_id in stale_ids:
            entities_map.pop(entity_id, None)

    def path_is_inside_scan_root(path):
        try:
            return os.path.commonpath(
                [scan_root_abs, os.path.abspath(path)]
            ) == scan_root_abs
        except ValueError:
            return False

    # --------------------------------------------------------------
    # Discover supported source files first.
    # --------------------------------------------------------------

    source_files = []
    ignored_dirs = {
        ".git",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__",
        ".code-index",
    }

    for root, dirs, files in os.walk(scan_root):
        dirs[:] = [
            directory
            for directory in dirs
            if directory not in ignored_dirs
        ]

        for file in files:
            path = os.path.normpath(os.path.join(root, file))
            ext = os.path.splitext(path)[1].lower()

            if ext in p.LANGUAGES:
                source_files.append(path)

    source_files.sort()
    current_paths = set(source_files)

    print(f"📚 Found {len(source_files)} supported source files.")

    scanned = 0
    skipped = 0
    entities_found = 0
    checkpoint_interval = 25

    try:
        for position, path in enumerate(source_files, start=1):
            try:
                digest = file_digest(path)
            except Exception as ex:
                print(f"⚠️  Hash error {path}: {ex}")
                continue

            if scan_state.get(path) == digest:
                skipped += 1
                continue

            # A changed file must replace all entities produced by its old
            # version before the new version is indexed.
            remove_entities_for_path(path)

            found = p.parse_file(path)

            for entity in found:
                entities_map[entity.id] = entity

            scan_state[path] = digest
            scanned += 1
            entities_found += len(found)

            print(
                f"[{position}/{len(source_files)}] "
                f"{path} -> {len(found)} entities"
            )

            if scanned % checkpoint_interval == 0:
                checkpoint()
                print(
                    f"💾 Checkpoint: {scanned} files processed "
                    f"this run."
                )

    except KeyboardInterrupt:
        print("\n⏸️  Scan interrupted. Saving progress...")
        checkpoint()
        print(
            "✅ Progress saved. Run the same scan command again "
            "to resume."
        )
        return

    # --------------------------------------------------------------
    # Remove entries for source files that existed during an older scan
    # but have since been deleted inside this scan root.
    # --------------------------------------------------------------

    deleted_paths = [
        path
        for path in list(scan_state)
        if path_is_inside_scan_root(path)
        and path not in current_paths
    ]

    for path in deleted_paths:
        remove_entities_for_path(path)
        scan_state.pop(path, None)

    checkpoint()

    print("\n✅ Scan complete.")
    print(f"  Source files:       {len(source_files)}")
    print(f"  Scanned/changed:    {scanned}")
    print(f"  Unchanged/skipped:  {skipped}")
    print(f"  Deleted:            {len(deleted_paths)}")
    print(f"  New entities read:  {entities_found}")
    print(f"  Total entities:     {len(entities_map)}")

    print("\n--- Next Recommended Step ---")
    print("1. Run 'code-indexer intents' if you have documentation in docs/intents/.")
    print("2. Run 'code-indexer summarize' for richer AI descriptions if desired.")
    print("3. Run 'code-indexer embed' to create/update search vectors.")

def cmd_intents(args):
    print("📘 Parsing intents from docs/intents/...")
    p = intents.IntentParser()
    items = p.parse_all()
    
    # Validation: check if mapped entities exist
    entities_map = storage.load_entities()
    valid_intents = []
    
    for intent in items:
        missing = [e for e in intent.mapped_entities if e not in entities_map]
        if missing:
            print(f"⚠️  Intent '{intent.id}' maps to unknown entities: {missing}")
        valid_intents.append(intent)
        
    storage.save_intents(valid_intents)
    print(f"✅ Saved {len(valid_intents)} intents.")

def cmd_summarize(args):
    # Тільки для low confidence
    entities_map = storage.load_entities()
    entities = list(entities_map.values())
    
    to_process = [e for e in entities if e.confidence == "low"]
    if not to_process:
        print("Nothing to summarize (all entities have medium/high confidence).")
        return

    print(f"🧠 Generating AI summaries for {len(to_process)} entities...")
    engine = ai.AIEngine(load_embedder=False)
    
    processed_count = 0
    try:
        # Тут треба читати сирий файл, щоб дати код LLM. 
        # В entities.json коду немає (економія місця).
        for e in to_process:
            try:
                with open(e.path, "r", encoding="utf-8") as f:
                    code = f.read() # Спрощено, треба шукати по рядках
                
                summary_text = engine.generate_summary(code)
                e.summary = EntitySummary(text=summary_text, source="llm")
                e.update_confidence() # Стане medium
                print(f"Processed {e.symbol}")
                processed_count += 1
                
                if processed_count % 10 == 0:
                    storage.save_entities(entities)
                    print(f"Saved progress ({processed_count}/{len(to_process)}).")

            except Exception as ex:
                print(f"Error reading {e.path}: {ex}")
    except KeyboardInterrupt:
        print("\nInterrupted. Saving progress...")
        storage.save_entities(entities)
        sys.exit(0)

    storage.save_entities(entities)
    print("✅ Summarization complete.")
    print("\n--- Next Recommended Step ---")
    print("Run 'code-indexer embed' to update the search index with these new descriptions.")

def cmd_embed(args):
    print("Geometry is everything. Embedding data...")
    entities_map = storage.load_entities()
    intent_list = storage.load_intents()

    engine = ai.AIEngine(load_embedder=True)

    ids = []
    texts = []

    for intent in intent_list:
        ids.append(intent.id)
        texts.append(
            "\n".join(
                [
                    f"Intent: {intent.id}",
                    f"Description: {intent.description}",
                ]
            )
        )

    for entity in entities_map.values():
        qualified_name = getattr(entity, "qualified_name", None)
        language = getattr(entity, "language", None)
        ast_kind = getattr(entity, "ast_kind", None)
        parent_symbol = getattr(entity, "parent_symbol", None)
        source_range = getattr(entity, "source_range", None)

        parts = [
            f"Code entity: {qualified_name or entity.symbol}",
            f"Symbol: {entity.symbol}",
            f"Kind: {entity.type}",
            f"Path: {entity.path}",
        ]

        if language:
            parts.append(f"Language: {language}")

        if ast_kind:
            parts.append(f"AST kind: {ast_kind}")

        if parent_symbol:
            parts.append(f"Parent: {parent_symbol}")

        if source_range:
            parts.append(
                f"Lines: {source_range.start_line}-{source_range.end_line}"
            )

        if entity.responsibility:
            parts.append(f"Responsibility: {entity.responsibility}")

        if entity.summary:
            parts.append(f"Summary: {entity.summary.text}")

        if entity.side_effects:
            parts.append(
                "Side effects: " + "; ".join(entity.side_effects)
            )

        ids.append(entity.id)
        texts.append("\n".join(parts))

    if not texts:
        print("Nothing to embed: no intents or code entities found.")
        print("Run 'code-indexer scan <path>' first.")
        return

    print(
        f"Embedding {len(texts)} documents "
        f"({len(entities_map)} code entities, "
        f"{len(intent_list)} intents)..."
    )

    matrix = engine.embed_texts(texts)
    storage.save_embeddings(ids, matrix)

    print(f"✅ Embedded {len(texts)} items.")
    print(f"   Vector dimension: {matrix.shape[1]}")

def cmd_search(args):
    ids, matrix = storage.load_embeddings()
    if matrix is None:
        print("Index empty. Run 'embed'.")
        return
        
    engine = ai.AIEngine(load_embedder=True)
    q_vec = engine.embed_texts([args.query])[0]
    
    # Cosine sim
    norm_mat = np.linalg.norm(matrix, axis=1)
    norm_q = np.linalg.norm(q_vec)
    scores = np.dot(matrix, q_vec) / (norm_mat * norm_q)
    
    top_k = scores.argsort()[-5:][::-1]
    
    print(f"\n🔍 Results for: '{args.query}'")
    for idx in top_k:
        obj_id = ids[idx]
        score = scores[idx]
        print(f"[{score:.4f}] {obj_id}")

def cmd_status(args):
    entities = storage.load_entities().values()
    intents_list = storage.load_intents()
    
    counts = {"low": 0, "medium": 0, "high": 0}
    for e in entities:
        counts[e.confidence] += 1
        
    print("--- Code Index Status ---")
    print(f"Intents: {len(intents_list)}")
    print(f"Entities: {len(entities)}")
    print(f"  High (Human):   {counts['high']}")
    print(f"  Medium (LLM):   {counts['medium']}")
    print(f"  Low (Raw):      {counts['low']}")
    
    print("\n--- Recommended Next Step ---")
    if len(entities) == 0:
        print("Run 'scan <path>' to index your codebase.")
    elif counts['low'] > 0:
        print(f"Run 'summarize' to analyze {counts['low']} new entities.")
        print("Or run 'embed' if you want to skip AI analysis for now.")
    elif not os.path.exists(os.path.join(storage.INDEX_DIR, "embeddings.npy")):
        print("Run 'embed' to build the search index.")
    else:
        print("Index is up to date! Try 'search \"your query\"'.")

def _read_entity_code(entity):
    with open(entity.path, "rb") as f:
        source_range = getattr(entity, "source_range", None)

        if source_range is None:
            return f.read().decode("utf-8", errors="replace")

        start = source_range.start_byte
        length = source_range.end_byte - source_range.start_byte

        f.seek(start)
        return f.read(length).decode("utf-8", errors="replace")


def _parse_summary_payload(text):
    text = text.strip()

    if text.startswith("```"):
        lines = text.splitlines()

        if lines:
            lines = lines[1:]

        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]

        text = "\n".join(lines).strip()

    try:
        payload = json.loads(text)
    except json.JSONDecodeError:
        start = text.find("[")
        end = text.rfind("]")

        if start == -1 or end == -1 or end <= start:
            raise

        payload = json.loads(text[start:end + 1])

    if isinstance(payload, dict):
        for key in ("results", "summaries", "intents"):
            if isinstance(payload.get(key), list):
                payload = payload[key]
                break

    if not isinstance(payload, list):
        raise ValueError("Expected a JSON array")

    return payload


def _summary_candidates(
    include_all=False,
    language=None,
    path_contains=None,
):
    entities = list(storage.load_entities().values())
    candidates = []

    for entity in entities:
        if not include_all and entity.summary is not None:
            continue

        entity_language = getattr(entity, "language", None)

        if language and entity_language != language:
            continue

        if path_contains and path_contains not in entity.path:
            continue

        candidates.append(entity)

    def sort_key(entity):
        source_range = getattr(entity, "source_range", None)
        start_line = source_range.start_line if source_range else 0

        return (
            entity.path,
            start_line,
            getattr(entity, "qualified_name", None) or entity.symbol,
        )

    candidates.sort(key=sort_key)
    return candidates


def _render_summary_batch(entities, max_code_chars):
    lines = [
        "# Code Entity Analysis Batch",
        "",
        "Analyze the code entities below.",
        "",
        "Use only information supported by the supplied code and structural metadata.",
        "Do not invent behavior that cannot be reasonably inferred from the code.",
        "",
        "For each entity:",
        "- responsibility: one concise sentence describing its semantic/business responsibility",
        "- side_effects: externally visible mutations, persistence, I/O, state changes, IPC, navigation, or other important effects",
        "- concepts: short semantic concepts useful for natural-language code search",
        "",
        "Return ONLY valid JSON. No Markdown fences, explanation, or prose outside JSON.",
        "",
        "Required format:",
        "[",
        "  {",
        "    \"id\": \"copy the entity ID exactly\",",
        "    \"responsibility\": \"one concise sentence\",",
        "    \"side_effects\": [\"effect\"],",
        "    \"concepts\": [\"concept\", \"concept\"]",
        "  }",
        "]",
        "",
        "Important:",
        "- Preserve every entity ID exactly.",
        "- Produce exactly one result object for every supplied entity.",
        "- If there are no side effects, return an empty array.",
        "- If a concept is uncertain, omit it rather than guessing.",
    ]

    exported_ids = []

    for index, entity in enumerate(entities, start=1):
        try:
            code = _read_entity_code(entity)
        except Exception as ex:
            print(f"⚠️  Could not read {entity.id}: {ex}")
            continue

        truncated = False

        if len(code) > max_code_chars:
            code = code[:max_code_chars]
            truncated = True

        qualified_name = getattr(entity, "qualified_name", None)
        parent_symbol = getattr(entity, "parent_symbol", None)
        language = getattr(entity, "language", None) or "text"
        ast_kind = getattr(entity, "ast_kind", None)
        source_range = getattr(entity, "source_range", None)

        exported_ids.append(entity.id)

        lines.extend(
            [
                "",
                f"## ENTITY {index}",
                f"ID: {entity.id}",
                f"SYMBOL: {entity.symbol}",
                f"QUALIFIED_NAME: {qualified_name or entity.symbol}",
                f"KIND: {entity.type}",
                f"LANGUAGE: {language}",
                f"PATH: {entity.path}",
            ]
        )

        if ast_kind:
            lines.append(f"AST_KIND: {ast_kind}")

        if parent_symbol:
            lines.append(f"PARENT: {parent_symbol}")

        if source_range:
            lines.append(
                f"LINES: {source_range.start_line}-{source_range.end_line}"
            )

        if truncated:
            lines.append(
                f"CODE_TRUNCATED: yes, first {max_code_chars} characters"
            )
        else:
            lines.append("CODE_TRUNCATED: no")

        lines.extend(
            [
                "",
                f"~~~~{language}",
                code,
                "~~~~",
            ]
        )

    return "\n".join(lines) + "\n", exported_ids


def _natural_sort_key(path):
    filename = os.path.basename(path)

    return [
        int(part) if part.isdigit() else part.lower()
        for part in re.split(r"(\d+)", filename)
    ]


def cmd_export_summary_batches(args):
    candidates = _summary_candidates(
        include_all=args.all,
        language=args.language,
        path_contains=args.path_contains,
    )

    if not candidates:
        print("✅ Nothing to export. All matching entities are summarized.")
        return

    if args.batch_size <= 0:
        raise ValueError("--batch-size must be greater than zero")

    os.makedirs(args.output_dir, exist_ok=True)

    batch_count = math.ceil(len(candidates) / args.batch_size)
    manifest_batches = []

    print("--- Summary Batch Export ---")
    print(f"Entities:      {len(candidates)}")
    print(f"Batch size:    {args.batch_size}")
    print(f"Batches:       {batch_count}")
    print(f"Output:        {args.output_dir}")
    print()

    for batch_index in range(batch_count):
        start = batch_index * args.batch_size
        end = start + args.batch_size
        batch_entities = candidates[start:end]

        number = batch_index + 1
        prompt_name = f"{args.prefix}{number}.md"
        result_name = f"{args.prefix}{number}.json"
        prompt_path = os.path.join(args.output_dir, prompt_name)

        if os.path.exists(prompt_path) and not args.overwrite:
            raise FileExistsError(
                f"{prompt_path} already exists. "
                "Use --overwrite or choose another output directory."
            )

        output, entity_ids = _render_summary_batch(
            batch_entities,
            args.max_code_chars,
        )

        with open(prompt_path, "w", encoding="utf-8") as f:
            f.write(output)

        manifest_batches.append(
            {
                "batch": number,
                "prompt_file": prompt_name,
                "expected_result_file": result_name,
                "entity_count": len(entity_ids),
                "entity_ids": entity_ids,
            }
        )

        print(
            f"  {prompt_name}: {len(entity_ids)} entities "
            f"→ expected {result_name}"
        )

    manifest = {
        "batch_size": args.batch_size,
        "entity_count": len(candidates),
        "batch_count": batch_count,
        "prefix": args.prefix,
        "language": args.language,
        "path_contains": args.path_contains,
        "batches": manifest_batches,
    }

    manifest_path = os.path.join(
        args.output_dir,
        "summary-batches-manifest.json",
    )

    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(
            manifest,
            f,
            indent=2,
            ensure_ascii=False,
        )

    print()
    print(f"✅ Exported {batch_count} batches.")
    print(f"Manifest: {manifest_path}")
    print()
    print(
        "Save web-AI responses beside the prompts using the expected "
        f"names ({args.prefix}1.json, {args.prefix}2.json, ...)."
    )


def cmd_import_summary_batches(args):
    pattern = os.path.join(args.input_dir, args.pattern)
    files = sorted(
        glob.glob(pattern),
        key=_natural_sort_key,
    )

    files = [
        path
        for path in files
        if os.path.basename(path) != "summary-batches-manifest.json"
    ]

    if not files:
        print(f"No summary result files matched: {pattern}")
        return

    print("--- Summary Batch Import ---")
    print(f"Directory: {args.input_dir}")
    print(f"Pattern:   {args.pattern}")
    print(f"Files:     {len(files)}")
    print()

    succeeded = 0
    failed = []

    for index, path in enumerate(files, start=1):
        print(
            f"=== [{index}/{len(files)}] "
            f"{os.path.basename(path)} ==="
        )

        import_args = argparse.Namespace(
            file=path,
            dry_run=args.dry_run,
            overwrite_human=args.overwrite_human,
        )

        try:
            cmd_import_summaries(import_args)
            succeeded += 1
        except Exception as ex:
            failed.append((path, str(ex)))
            print(f"❌ Failed: {ex}")

        print()

    print("--- Batch Import Result ---")
    print(f"Succeeded: {succeeded}")
    print(f"Failed:    {len(failed)}")

    if failed:
        print("\nFailed files:")

        for path, error in failed:
            print(f"  {path}: {error}")

    if args.dry_run:
        print("\nDry run only. No entities were modified.")
    elif succeeded:
        print("\nRun 'code-indexer summary-status' to inspect remaining work.")
        print("Run 'code-indexer embed' after finishing imports.")


def cmd_export_summaries(args):
    candidates = _summary_candidates(
        include_all=args.all,
        language=args.language,
        path_contains=args.path_contains,
    )

    selected = candidates[:args.limit]

    if not selected:
        print("Nothing to export.")
        print("All matching entities may already be summarized.")
        return

    output, exported_ids = _render_summary_batch(
        selected,
        args.max_code_chars,
    )

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(output)

        print(
            f"✅ Exported {len(exported_ids)} entities "
            f"to {args.output}"
        )
    else:
        print(output, end="")

    remaining = max(0, len(candidates) - len(selected))

    if remaining:
        print(f"Remaining matching entities: {remaining}")


def cmd_import_summaries(args):
    with open(args.file, "r", encoding="utf-8") as f:
        payload = _parse_summary_payload(f.read())

    entities = storage.load_entities()

    imported = 0
    unknown = 0
    invalid = 0
    protected = 0

    for item in payload:
        if not isinstance(item, dict):
            invalid += 1
            continue

        entity_id = item.get("id")
        responsibility = item.get("responsibility")

        if not isinstance(entity_id, str) or not entity_id:
            invalid += 1
            continue

        if not isinstance(responsibility, str) or not responsibility.strip():
            invalid += 1
            print(f"⚠️  Missing responsibility for {entity_id}")
            continue

        entity = entities.get(entity_id)

        if entity is None:
            unknown += 1
            print(f"⚠️  Unknown entity ID: {entity_id}")
            continue

        if (
            entity.summary
            and entity.summary.source == "human"
            and not args.overwrite_human
        ):
            protected += 1
            print(f"🛡️  Keeping human summary: {entity_id}")
            continue

        raw_effects = item.get("side_effects", [])

        if not isinstance(raw_effects, list):
            raw_effects = []

        side_effects = [
            value.strip()
            for value in raw_effects
            if isinstance(value, str) and value.strip()
        ]

        raw_concepts = item.get("concepts", [])

        if not isinstance(raw_concepts, list):
            raw_concepts = []

        concepts = [
            value.strip()
            for value in raw_concepts
            if isinstance(value, str) and value.strip()
        ]

        responsibility = responsibility.strip()

        if not args.dry_run:
            entity.responsibility = responsibility
            entity.side_effects = side_effects

            summary_text = responsibility

            if concepts:
                summary_text += " Concepts: " + "; ".join(concepts) + "."

            entity.summary = EntitySummary(
                text=summary_text,
                source="web_ai",
            )
            entity.update_confidence()

        imported += 1

    if not args.dry_run:
        storage.save_entities(list(entities.values()))

    action = "Would import" if args.dry_run else "Imported"

    print(f"✅ {action}: {imported}")
    print(f"   Unknown IDs:       {unknown}")
    print(f"   Invalid entries:   {invalid}")
    print(f"   Human protected:   {protected}")

    if not args.dry_run and imported:
        print("\nRun 'code-indexer embed' to rebuild semantic vectors.")


def cmd_summary_status(args):
    entities = list(storage.load_entities().values())

    filtered = []

    for entity in entities:
        language = getattr(entity, "language", None)

        if args.language and language != args.language:
            continue

        if args.path_contains and args.path_contains not in entity.path:
            continue

        filtered.append(entity)

    total = len(filtered)
    remaining = [entity for entity in filtered if entity.summary is None]
    summarized = total - len(remaining)

    source_counts = {
        "human": 0,
        "llm": 0,
        "web_ai": 0,
        "none": 0,
    }

    language_stats = {}
    directory_remaining = {}

    for entity in filtered:
        language = getattr(entity, "language", None) or "unknown"
        stats = language_stats.setdefault(
            language,
            {"total": 0, "remaining": 0},
        )
        stats["total"] += 1

        if entity.summary is None:
            source_counts["none"] += 1
            stats["remaining"] += 1

            directory = os.path.dirname(entity.path) or "."
            directory_remaining[directory] = (
                directory_remaining.get(directory, 0) + 1
            )
        else:
            source = entity.summary.source
            source_counts[source] = source_counts.get(source, 0) + 1

    percent = (summarized / total * 100.0) if total else 0.0

    print("--- Summary Status ---")
    print(f"Entities in scope:    {total}")
    print(f"Summarized:           {summarized} ({percent:.1f}%)")
    print(f"Remaining:            {len(remaining)} ({100.0 - percent:.1f}%)" if total else "Remaining:            0")

    print("\nSources:")
    print(f"  Human:              {source_counts.get('human', 0)}")
    print(f"  Local LLM:          {source_counts.get('llm', 0)}")
    print(f"  Web AI:             {source_counts.get('web_ai', 0)}")
    print(f"  None:               {source_counts.get('none', 0)}")

    if language_stats:
        print("\nBy language:")

        for language, stats in sorted(language_stats.items()):
            done = stats["total"] - stats["remaining"]
            language_percent = (
                done / stats["total"] * 100.0
                if stats["total"]
                else 0.0
            )
            print(
                f"  {language}: {done}/{stats['total']} "
                f"({language_percent:.1f}%), "
                f"remaining {stats['remaining']}"
            )

    if directory_remaining:
        print("\nDirectories with most remaining entities:")

        ranked = sorted(
            directory_remaining.items(),
            key=lambda item: (-item[1], item[0]),
        )[:args.top_dirs]

        for directory, count in ranked:
            print(f"  {count:4d}  {directory}")

    if args.list:
        print("\nRemaining entities:")

        ordered = sorted(
            remaining,
            key=lambda entity: (
                entity.path,
                getattr(getattr(entity, "source_range", None), "start_line", 0),
                entity.symbol,
            ),
        )

        for entity in ordered[:args.limit]:
            name = getattr(entity, "qualified_name", None) or entity.symbol
            source_range = getattr(entity, "source_range", None)
            line = source_range.start_line if source_range else "?"
            print(f"  {entity.path}:{line}  {name}")

        hidden = len(ordered) - min(len(ordered), args.limit)

        if hidden > 0:
            print(f"  ... and {hidden} more")


def cmd_export_intents(args):
    entities = list(storage.load_entities().values())
    existing_intents = storage.load_intents()
    candidates = []

    for entity in entities:
        language = getattr(entity, "language", None)

        if args.language and language != args.language:
            continue

        if args.path_contains and args.path_contains not in entity.path:
            continue

        if not args.include_raw and entity.summary is None:
            continue

        candidates.append(entity)

    def sort_key(entity):
        source_range = getattr(entity, "source_range", None)
        start_line = source_range.start_line if source_range else 0
        return entity.path, start_line, entity.symbol

    candidates.sort(key=sort_key)
    selected = candidates[:args.limit]

    if not selected:
        print("Nothing to export for intent analysis.")
        print("Summarize entities first or use --include-raw.")
        return

    lines = [
        "# Codebase Intent Discovery Batch",
        "",
        "Infer coherent domain/user-facing intents from the supplied code entities.",
        "",
        "An intent is a meaningful capability, behavior, workflow, or domain responsibility of the system.",
        "Do NOT create one intent per function.",
        "Do NOT merely restate implementation mechanisms such as rendering, hooks, setters, or parsing unless they represent a meaningful system capability.",
        "Prefer grouping multiple collaborating entities under one intent.",
        "Use only the supplied entity IDs in mapped_entities.",
        "Do not invent entity IDs.",
        "Do not invent capabilities unsupported by the supplied information.",
        "",
        f"Return at most {args.max_intents} intents.",
        "",
        "Return ONLY valid JSON, with no Markdown fences or prose outside JSON.",
        "",
        "Required format:",
        "[",
        "  {",
        "    \"id\": \"intent.short_snake_case_name\",",
        "    \"description\": \"concise description of the capability or behavior\",",
        "    \"responsibilities\": [\"what this intent owns\"],",
        "    \"non_responsibilities\": [\"important nearby concern it does not own\"],",
        "    \"mapped_entities\": [\"exact entity ID\"]",
        "  }",
        "]",
        "",
        "Quality rules:",
        "- Prefer 3-12 mapped entities for a substantial intent when the evidence supports it.",
        "- A small focused intent may legitimately have fewer entities.",
        "- Avoid duplicate or heavily overlapping intents.",
        "- Keep descriptions semantic rather than syntactic.",
    ]

    if existing_intents:
        lines.extend(
            [
                "",
                "## EXISTING INTENTS",
                "Do not recreate these unless the supplied entities clearly justify a distinct capability:",
            ]
        )

        for intent in existing_intents:
            lines.append(f"- {intent.id}: {intent.description}")

    lines.extend(["", "## ENTITIES"])

    for index, entity in enumerate(selected, start=1):
        qualified_name = getattr(entity, "qualified_name", None)
        language = getattr(entity, "language", None) or "unknown"
        parent_symbol = getattr(entity, "parent_symbol", None)
        source_range = getattr(entity, "source_range", None)

        lines.extend(
            [
                "",
                f"### ENTITY {index}",
                f"ID: {entity.id}",
                f"NAME: {qualified_name or entity.symbol}",
                f"KIND: {entity.type}",
                f"LANGUAGE: {language}",
                f"PATH: {entity.path}",
            ]
        )

        if parent_symbol:
            lines.append(f"PARENT: {parent_symbol}")

        if source_range:
            lines.append(
                f"LINES: {source_range.start_line}-{source_range.end_line}"
            )

        if entity.responsibility:
            lines.append(f"RESPONSIBILITY: {entity.responsibility}")

        if entity.summary:
            lines.append(f"SUMMARY: {entity.summary.text}")

        if entity.side_effects:
            lines.append(
                "SIDE_EFFECTS: " + "; ".join(entity.side_effects)
            )

        if args.include_code:
            try:
                code = _read_entity_code(entity)

                if len(code) > args.max_code_chars:
                    code = code[:args.max_code_chars]
                    code += "\n[TRUNCATED]"

                lines.extend(
                    [
                        "CODE:",
                        "~~~~",
                        code,
                        "~~~~",
                    ]
                )
            except Exception as ex:
                lines.append(f"CODE_READ_ERROR: {ex}")

    output = "\n".join(lines) + "\n"

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(output)

        print(f"✅ Exported {len(selected)} entities to {args.output}")
    else:
        print(output, end="")

    remaining = max(0, len(candidates) - len(selected))

    if remaining:
        print(f"Matching entities not included in this batch: {remaining}")


def cmd_import_intents(args):
    with open(args.file, "r", encoding="utf-8") as f:
        payload = _parse_summary_payload(f.read())

    entities = storage.load_entities()
    existing_list = storage.load_intents()
    intents_by_id = {intent.id: intent for intent in existing_list}

    imported = 0
    existing_skipped = 0
    invalid = 0
    no_valid_entities = 0
    unknown_entity_refs = 0

    for item in payload:
        if not isinstance(item, dict):
            invalid += 1
            continue

        intent_id = item.get("id")
        description = item.get("description")

        if not isinstance(intent_id, str) or not intent_id.startswith("intent."):
            print(f"⚠️  Invalid intent ID: {intent_id}")
            invalid += 1
            continue

        if not isinstance(description, str) or not description.strip():
            print(f"⚠️  Missing description: {intent_id}")
            invalid += 1
            continue

        if intent_id in intents_by_id and not args.overwrite:
            print(f"🛡️  Existing intent kept: {intent_id}")
            existing_skipped += 1
            continue

        def clean_strings(value):
            if not isinstance(value, list):
                return []

            return [
                item.strip()
                for item in value
                if isinstance(item, str) and item.strip()
            ]

        responsibilities = clean_strings(item.get("responsibilities", []))
        non_responsibilities = clean_strings(
            item.get("non_responsibilities", [])
        )
        requested_entities = clean_strings(
            item.get("mapped_entities", [])
        )

        mapped_entities = []

        for entity_id in requested_entities:
            if entity_id in entities:
                mapped_entities.append(entity_id)
            else:
                unknown_entity_refs += 1
                print(
                    f"⚠️  {intent_id}: unknown entity ID ignored: "
                    f"{entity_id}"
                )

        if not mapped_entities:
            print(f"⚠️  {intent_id}: no valid mapped entities; skipped")
            no_valid_entities += 1
            continue

        intent = Intent(
            id=intent_id,
            description=description.strip(),
            responsibilities=responsibilities,
            non_responsibilities=non_responsibilities,
            mapped_entities=mapped_entities,
            source="web_ai",
        )

        if not args.dry_run:
            intents_by_id[intent_id] = intent

        imported += 1

    if not args.dry_run:
        storage.save_intents(
            sorted(
                intents_by_id.values(),
                key=lambda intent: intent.id,
            )
        )

    action = "Would import" if args.dry_run else "Imported"

    print(f"✅ {action}: {imported}")
    print(f"   Existing protected:   {existing_skipped}")
    print(f"   Invalid intents:      {invalid}")
    print(f"   No valid entities:    {no_valid_entities}")
    print(f"   Unknown entity refs:  {unknown_entity_refs}")

    if not args.dry_run and imported:
        print("\nRun 'code-indexer embed' so intents participate in search.")


def main():
    parser = argparse.ArgumentParser(prog="code-indexer")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("scan").add_argument("root")
    sub.add_parser("intents")
    sub.add_parser("summarize")
    sub.add_parser("embed")
    sub.add_parser("search").add_argument("query")
    sub.add_parser("status")

    summary_status_parser = sub.add_parser(
        "summary-status",
        help="Show summarization progress and remaining entities.",
    )
    summary_status_parser.add_argument("--language")
    summary_status_parser.add_argument("--path-contains")
    summary_status_parser.add_argument(
        "--list",
        action="store_true",
        help="List remaining unsummarized entities.",
    )
    summary_status_parser.add_argument(
        "--limit",
        type=int,
        default=50,
        help="Maximum remaining entities to list.",
    )
    summary_status_parser.add_argument(
        "--top-dirs",
        type=int,
        default=10,
        help="Number of directories to show in the remaining-work ranking.",
    )

    export_parser = sub.add_parser(
        "export-summaries",
        help="Export one code-entity batch for manual web-AI analysis.",
    )
    export_parser.add_argument(
        "--limit",
        type=int,
        default=20,
    )
    export_parser.add_argument("--output")
    export_parser.add_argument("--language")
    export_parser.add_argument("--path-contains")
    export_parser.add_argument(
        "--max-code-chars",
        type=int,
        default=8000,
    )
    export_parser.add_argument(
        "--all",
        action="store_true",
    )

    export_batches_parser = sub.add_parser(
        "export-summary-batches",
        help="Export all remaining entities into numbered web-AI batches.",
    )
    export_batches_parser.add_argument(
        "--output-dir",
        default="summary-batches",
    )
    export_batches_parser.add_argument(
        "--batch-size",
        type=int,
        default=20,
    )
    export_batches_parser.add_argument(
        "--prefix",
        default="f",
    )
    export_batches_parser.add_argument("--language")
    export_batches_parser.add_argument("--path-contains")
    export_batches_parser.add_argument(
        "--max-code-chars",
        type=int,
        default=8000,
    )
    export_batches_parser.add_argument(
        "--all",
        action="store_true",
    )
    export_batches_parser.add_argument(
        "--overwrite",
        action="store_true",
    )

    import_parser = sub.add_parser(
        "import-summaries",
        help="Import one JSON response returned by a web AI chat.",
    )
    import_parser.add_argument("file")
    import_parser.add_argument(
        "--dry-run",
        action="store_true",
    )
    import_parser.add_argument(
        "--overwrite-human",
        action="store_true",
    )

    import_batches_parser = sub.add_parser(
        "import-summary-batches",
        help="Import multiple numbered web-AI summary result files.",
    )
    import_batches_parser.add_argument("input_dir")
    import_batches_parser.add_argument(
        "--pattern",
        default="f*.json",
    )
    import_batches_parser.add_argument(
        "--dry-run",
        action="store_true",
    )
    import_batches_parser.add_argument(
        "--overwrite-human",
        action="store_true",
    )

    export_intents_parser = sub.add_parser(
        "export-intents",
        help="Export entity metadata for manual web-AI intent discovery.",
    )
    export_intents_parser.add_argument(
        "--limit",
        type=int,
        default=80,
    )
    export_intents_parser.add_argument("--output")
    export_intents_parser.add_argument("--language")
    export_intents_parser.add_argument("--path-contains")
    export_intents_parser.add_argument(
        "--max-intents",
        type=int,
        default=12,
    )
    export_intents_parser.add_argument(
        "--include-raw",
        action="store_true",
    )
    export_intents_parser.add_argument(
        "--include-code",
        action="store_true",
    )
    export_intents_parser.add_argument(
        "--max-code-chars",
        type=int,
        default=4000,
    )

    import_intents_parser = sub.add_parser(
        "import-intents",
        help="Import intent JSON returned by a web AI chat.",
    )
    import_intents_parser.add_argument("file")
    import_intents_parser.add_argument(
        "--dry-run",
        action="store_true",
    )
    import_intents_parser.add_argument(
        "--overwrite",
        action="store_true",
    )

    args = parser.parse_args()

    if args.cmd == "scan":
        cmd_scan(args)
    elif args.cmd == "intents":
        cmd_intents(args)
    elif args.cmd == "summarize":
        cmd_summarize(args)
    elif args.cmd == "embed":
        cmd_embed(args)
    elif args.cmd == "search":
        cmd_search(args)
    elif args.cmd == "status":
        cmd_status(args)
    elif args.cmd == "summary-status":
        cmd_summary_status(args)
    elif args.cmd == "export-summaries":
        cmd_export_summaries(args)
    elif args.cmd == "export-summary-batches":
        cmd_export_summary_batches(args)
    elif args.cmd == "import-summaries":
        cmd_import_summaries(args)
    elif args.cmd == "import-summary-batches":
        cmd_import_summary_batches(args)
    elif args.cmd == "export-intents":
        cmd_export_intents(args)
    elif args.cmd == "import-intents":
        cmd_import_intents(args)

if __name__ == "__main__":
    main()

import os

from tree_sitter import Language, Parser, Query, QueryCursor

from .schema import CodeEntity, EntitySummary


class CodeParser:
    def __init__(self):
        import tree_sitter_python
        import tree_sitter_kotlin
        import tree_sitter_go
        import tree_sitter_typescript
        import tree_sitter_javascript

        # --------------------------------------------------------------
        # Languages
        # --------------------------------------------------------------

        self.LANGUAGES = {
            ".py": Language(tree_sitter_python.language()),
            ".kt": Language(tree_sitter_kotlin.language()),
            ".go": Language(tree_sitter_go.language()),

            ".ts": Language(
                tree_sitter_typescript.language_typescript()
            ),
            ".tsx": Language(
                tree_sitter_typescript.language_tsx()
            ),

            ".js": Language(
                tree_sitter_javascript.language()
            ),
            ".jsx": Language(
                tree_sitter_javascript.language()
            ),
        }

        # --------------------------------------------------------------
        # Queries
        # --------------------------------------------------------------

        python_query = r"""
            (function_definition
                name: (identifier) @name
            ) @def

            (class_definition
                name: (identifier) @name
            ) @def
        """

        kotlin_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (class_declaration
                name: (identifier) @name
            ) @def
        """

        go_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (method_declaration
                name: (field_identifier) @name
            ) @def
        """

        typescript_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (class_declaration
                name: (type_identifier) @name
            ) @def

            (interface_declaration
                name: (type_identifier) @name
            ) @def

            (type_alias_declaration
                name: (type_identifier) @name
            ) @def

            (enum_declaration
                name: (identifier) @name
            ) @def

            (method_definition
                name: (_) @name
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (arrow_function)
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (function_expression)
            ) @def
        """

        javascript_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (class_declaration
                name: (identifier) @name
            ) @def

            (method_definition
                name: (_) @name
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (arrow_function)
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (function_expression)
            ) @def
        """

        self.QUERIES = {
            ".py": python_query,
            ".kt": kotlin_query,
            ".go": go_query,

            ".ts": typescript_query,
            ".tsx": typescript_query,

            ".js": javascript_query,
            ".jsx": javascript_query,
        }

    def parse_file(self, filepath: str) -> list[CodeEntity]:
        ext = os.path.splitext(filepath)[1].lower()

        lang = self.LANGUAGES.get(ext)
        if lang is None:
            return []

        query_scm = self.QUERIES.get(ext)
        if query_scm is None:
            return []

        # --------------------------------------------------------------
        # Read source
        # --------------------------------------------------------------

        try:
            with open(filepath, "rb") as f:
                code_bytes = f.read()
        except Exception as e:
            print(f"Read error {filepath}: {e}")
            return []

        # --------------------------------------------------------------
        # Parse AST
        # --------------------------------------------------------------

        try:
            parser = Parser(lang)
            tree = parser.parse(code_bytes)
        except Exception as e:
            print(f"Parse error {filepath}: {e}")
            return []

        # --------------------------------------------------------------
        # Query AST
        # --------------------------------------------------------------

        try:
            query = Query(lang, query_scm)
            cursor = QueryCursor(query)
            captures_dict = cursor.captures(tree.root_node)
        except Exception as e:
            print(f"Query error {filepath}: {e}")
            return []

        entities = []
        processed = set()

        # --------------------------------------------------------------
        # Extract definitions
        # --------------------------------------------------------------

        definition_nodes = captures_dict.get("def", [])

        for node in definition_nodes:
            key = (node.start_byte, node.end_byte)

            if key in processed:
                continue

            processed.add(key)

            name_node = node.child_by_field_name("name")

            if name_node is None:
                continue

            try:
                symbol = name_node.text.decode("utf-8").strip()
            except Exception:
                continue

            if not symbol:
                continue

            try:
                full_code = node.text.decode("utf-8")
            except Exception:
                full_code = ""

            summary_text, responsibility, effects = (
                self._parse_contract(full_code)
            )

            summary_obj = None

            if summary_text:
                summary_obj = EntitySummary(
                    text=summary_text,
                    source="human",
                )

            entity_type = self._entity_type(node.type)

            entity = CodeEntity(
                id=self._make_entity_id(
                    filepath=filepath,
                    symbol=symbol,
                    node=node,
                ),
                type=entity_type,
                path=filepath,
                symbol=symbol,
                summary=summary_obj,
                responsibility=responsibility,
                side_effects=effects,
                confidence="low",
            )

            entity.update_confidence()
            entities.append(entity)

        return entities

    def _entity_type(self, node_type: str) -> str:
        """
        Current schema supports only:
            function
            class
            file

        Interface/enum/type alias are temporarily treated as class-like.
        """

        class_like = {
            "class_definition",
            "class_declaration",
            "interface_declaration",
            "enum_declaration",
            "type_alias_declaration",
        }

        if node_type in class_like:
            return "class"

        return "function"

    def _make_entity_id(
        self,
        filepath: str,
        symbol: str,
        node,
    ) -> str:
        """
        Temporary ID.

        Line number avoids collisions between e.g. multiple save()
        methods in the same file.

        Later this should become a qualified symbol ID.
        """

        start_line = node.start_point[0] + 1

        return f"{filepath}:{symbol}:{start_line}"

    def _parse_contract(self, text: str):
        """
        Parse optional human contracts:

            // responsibility: ...
            // side effect: ...

            # responsibility: ...
            # side effect: ...

            @responsibility:
            @side-effect:
        """

        responsibility = None
        side_effects = []

        for line in text.splitlines():
            clean = (
                line
                .replace("//", "")
                .replace("#", "")
                .replace("/*", "")
                .replace("*/", "")
                .strip()
            )

            lower = clean.lower()

            if (
                "responsibility:" in lower
                or "@responsibility:" in lower
            ):
                parts = clean.split(":", 1)

                if len(parts) == 2:
                    value = parts[1].strip()

                    if value:
                        responsibility = value

            elif (
                "side effect:" in lower
                or "@side-effect:" in lower
            ):
                parts = clean.split(":", 1)

                if len(parts) == 2:
                    value = parts[1].strip()

                    if value:
                        side_effects.append(value)

        summary_text = responsibility

        return summary_text, responsibility, side_effects

import os

from tree_sitter import Language, Parser, Query, QueryCursor

from .schema import CodeEntity, EntitySummary, SourceRange


class CodeParser:
    def __init__(self):
        import tree_sitter_python
        import tree_sitter_kotlin
        import tree_sitter_go
        import tree_sitter_typescript
        import tree_sitter_javascript

        # --------------------------------------------------------------
        # Languages
        # --------------------------------------------------------------

        self.LANGUAGES = {
            ".py": Language(tree_sitter_python.language()),
            ".kt": Language(tree_sitter_kotlin.language()),
            ".go": Language(tree_sitter_go.language()),

            ".ts": Language(
                tree_sitter_typescript.language_typescript()
            ),
            ".tsx": Language(
                tree_sitter_typescript.language_tsx()
            ),

            ".js": Language(
                tree_sitter_javascript.language()
            ),
            ".jsx": Language(
                tree_sitter_javascript.language()
            ),
        }

        # --------------------------------------------------------------
        # Queries
        # --------------------------------------------------------------

        python_query = r"""
            (function_definition
                name: (identifier) @name
            ) @def

            (class_definition
                name: (identifier) @name
            ) @def
        """

        kotlin_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (class_declaration
                name: (identifier) @name
            ) @def
        """

        go_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (method_declaration
                name: (field_identifier) @name
            ) @def
        """

        typescript_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (class_declaration
                name: (type_identifier) @name
            ) @def

            (interface_declaration
                name: (type_identifier) @name
            ) @def

            (type_alias_declaration
                name: (type_identifier) @name
            ) @def

            (enum_declaration
                name: (identifier) @name
            ) @def

            (method_definition
                name: (_) @name
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (arrow_function)
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (function_expression)
            ) @def
        """

        javascript_query = r"""
            (function_declaration
                name: (identifier) @name
            ) @def

            (class_declaration
                name: (identifier) @name
            ) @def

            (method_definition
                name: (_) @name
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (arrow_function)
            ) @def

            (variable_declarator
                name: (identifier) @name
                value: (function_expression)
            ) @def
        """

        self.QUERIES = {
            ".py": python_query,
            ".kt": kotlin_query,
            ".go": go_query,

            ".ts": typescript_query,
            ".tsx": typescript_query,

            ".js": javascript_query,
            ".jsx": javascript_query,
        }

def parse_file(self, filepath: str) -> list[CodeEntity]:
    ext = os.path.splitext(filepath)[1].lower()

    lang = self.LANGUAGES.get(ext)
    if lang is None:
        return []

    query_scm = self.QUERIES.get(ext)
    if query_scm is None:
        return []

    language_by_extension = {
        ".py": "python",
        ".kt": "kotlin",
        ".go": "go",
        ".ts": "typescript",
        ".tsx": "typescript",
        ".js": "javascript",
        ".jsx": "javascript",
    }
    language = language_by_extension.get(ext, ext.lstrip("."))
    normalized_path = os.path.normpath(filepath)

    try:
        with open(filepath, "rb") as f:
            code_bytes = f.read()
    except Exception as e:
        print(f"Read error {filepath}: {e}")
        return []

    try:
        source_parser = Parser(lang)
        tree = source_parser.parse(code_bytes)
    except Exception as e:
        print(f"Parse error {filepath}: {e}")
        return []

    try:
        query = Query(lang, query_scm)
        cursor = QueryCursor(query)
        captures_dict = cursor.captures(tree.root_node)
    except Exception as e:
        print(f"Query error {filepath}: {e}")
        return []

    definition_nodes = sorted(
        captures_dict.get("def", []),
        key=lambda node: (
            node.start_byte,
            -(node.end_byte - node.start_byte),
        ),
    )

    entities = []
    records = []
    processed = set()

    for node in definition_nodes:
        node_key = (node.start_byte, node.end_byte)

        if node_key in processed:
            continue

        processed.add(node_key)

        name_node = node.child_by_field_name("name")
        if name_node is None:
            continue

        try:
            symbol = name_node.text.decode("utf-8").strip()
        except Exception:
            continue

        if not symbol:
            continue

        parent_record = None
        parent_span = None

        for candidate in records:
            parent_node = candidate["node"]

            contains = (
                parent_node.start_byte <= node.start_byte
                and parent_node.end_byte >= node.end_byte
                and (
                    parent_node.start_byte != node.start_byte
                    or parent_node.end_byte != node.end_byte
                )
            )

            if not contains:
                continue

            span = parent_node.end_byte - parent_node.start_byte

            if parent_record is None or span < parent_span:
                parent_record = candidate
                parent_span = span

        parent_type = (
            parent_record["type"]
            if parent_record is not None
            else None
        )

        node_type = node.type

        if node_type in {
            "method_declaration",
            "method_definition",
            "method_signature",
        }:
            entity_type = "method"
        elif (
            node_type in {
                "function_definition",
                "function_declaration",
            }
            and parent_type in {"class", "interface"}
        ):
            entity_type = "method"
        elif node_type in {
            "class_definition",
            "class_declaration",
            "abstract_class_declaration",
        }:
            entity_type = "class"
        elif node_type == "interface_declaration":
            entity_type = "interface"
        elif node_type == "enum_declaration":
            entity_type = "enum"
        elif node_type == "type_alias_declaration":
            entity_type = "type_alias"
        else:
            entity_type = "function"

        if parent_record is not None:
            qualified_name = (
                f'{parent_record["qualified_name"]}.{symbol}'
            )
            parent_id = parent_record["id"]
            parent_symbol = parent_record["symbol"]
        else:
            qualified_name = symbol
            parent_id = None
            parent_symbol = None

        start_line = node.start_point[0] + 1
        entity_id = (
            f"{language}:{normalized_path}:"
            f"{qualified_name}:{start_line}"
        )

        try:
            full_code = node.text.decode("utf-8")
        except Exception:
            full_code = ""

        summary_text, responsibility, effects = self._parse_contract(full_code)

        summary_obj = None
        if summary_text:
            summary_obj = EntitySummary(
                text=summary_text,
                source="human",
            )

        source_range = SourceRange(
            start_line=start_line,
            start_column=node.start_point[1] + 1,
            end_line=node.end_point[0] + 1,
            end_column=node.end_point[1] + 1,
            start_byte=node.start_byte,
            end_byte=node.end_byte,
        )

        entity = CodeEntity(
            id=entity_id,
            type=entity_type,
            path=normalized_path,
            symbol=symbol,
            language=language,
            ast_kind=node_type,
            qualified_name=qualified_name,
            parent_id=parent_id,
            parent_symbol=parent_symbol,
            source_range=source_range,
            summary=summary_obj,
            responsibility=responsibility,
            side_effects=effects,
            confidence="low",
        )

        entity.update_confidence()
        entities.append(entity)

        records.append(
            {
                "node": node,
                "id": entity_id,
                "type": entity_type,
                "symbol": symbol,
                "qualified_name": qualified_name,
            }
        )

    return entities

    def _entity_type(self, node_type: str) -> str:
        """
        Current schema supports only:
            function
            class
            file

        Interface/enum/type alias are temporarily treated as class-like.
        """

        class_like = {
            "class_definition",
            "class_declaration",
            "interface_declaration",
            "enum_declaration",
            "type_alias_declaration",
        }

        if node_type in class_like:
            return "class"

        return "function"

    def _make_entity_id(
        self,
        filepath: str,
        symbol: str,
        node,
    ) -> str:
        """
        Temporary ID.

        Line number avoids collisions between e.g. multiple save()
        methods in the same file.

        Later this should become a qualified symbol ID.
        """

        start_line = node.start_point[0] + 1

        return f"{filepath}:{symbol}:{start_line}"

    def _parse_contract(self, text: str):
        """
        Parse optional human contracts:

            // responsibility: ...
            // side effect: ...

            # responsibility: ...
            # side effect: ...

            @responsibility:
            @side-effect:
        """

        responsibility = None
        side_effects = []

        for line in text.splitlines():
            clean = (
                line
                .replace("//", "")
                .replace("#", "")
                .replace("/*", "")
                .replace("*/", "")
                .strip()
            )

            lower = clean.lower()

            if (
                "responsibility:" in lower
                or "@responsibility:" in lower
            ):
                parts = clean.split(":", 1)

                if len(parts) == 2:
                    value = parts[1].strip()

                    if value:
                        responsibility = value

            elif (
                "side effect:" in lower
                or "@side-effect:" in lower
            ):
                parts = clean.split(":", 1)

                if len(parts) == 2:
                    value = parts[1].strip()

                    if value:
                        side_effects.append(value)

        summary_text = responsibility

        return summary_text, responsibility, side_effects
